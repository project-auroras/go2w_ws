<?xml version="1.0" encoding="UTF-8"?>
<!-- Network interface connected to the robot (192.168.123.x), taken from $GO2_IFACE -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="${GO2_IFACE}" priority="default" multicast="default"/>
      </Interfaces>
    </General>
  </Domain>
</CycloneDDS>
