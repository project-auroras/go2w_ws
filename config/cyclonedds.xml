<?xml version="1.0" encoding="UTF-8"?>
<!-- Reference only: scripts/env.sh builds this same config inline in CYCLONEDDS_URI with
     the interface already expanded (network interface connected to the robot, 192.168.123.x). -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="${GO2_IFACE}" priority="default" multicast="default"/>
      </Interfaces>
    </General>
  </Domain>
</CycloneDDS>
