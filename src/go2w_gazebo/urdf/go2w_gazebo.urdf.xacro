<?xml version="1.0"?>
<!--
  Go2-W para Gazebo Fortress: el URDF de go2w_description + una RealSense (RGB-D)
  + plugins para que se tenga de pie y ruede.
  - Patas: JointPositionController sujeta cada articulación en la postura de pie.
  - Ruedas: DiffDrive (4 ruedas, como el Go2-W real) lee /cmd_vel y publica odom + TF.
  - Cámara: rgbd_camera con los datos de la D435i (69 deg, 640x480), en el camera_link
    del URDF (soporte delantero, 20 deg hacia arriba).
-->
<robot name="go2w" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find go2w_description)/urdf/go2w.urdf.xacro"/>

  <!-- Postura de pie (la misma que usa sim_go2w) -->
  <xacro:property name="stand_thigh" value="0.67"/>
  <xacro:property name="stand_calf" value="-1.3"/>

  <!-- ===== RealSense =====
       camera_link (base_link -> camera_link, medido en el robot) viene del URDF de
       go2w_description. Aquí se añade lo que en el robot real publica el driver
       realsense2_camera: el frame óptico y el propio sensor. -->
  <!-- frame óptico: z delante, x derecha, y abajo (como la RealSense real) -->
  <link name="camera_color_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    <parent link="camera_link"/>
    <child link="camera_color_optical_frame"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor name="realsense" type="rgbd_camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <topic>/rgbd</topic>
      <ignition_frame_id>camera_color_optical_frame</ignition_frame_id>
      <camera>
        <horizontal_fov>1.204</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.1</near><far>20</far></clip>
        <depth_camera><clip><near>0.1</near><far>10</far></clip></depth_camera>
      </camera>
    </sensor>
  </gazebo>

  <!-- ===== Rozamiento de las ruedas =====
       Con 4 ruedas fijas el robot gira derrapando (skid steer). Con mucho agarre
       lateral casi no gira y, al girar sobre sí mismo, cabecea hasta volcar.
       fdir1 = eje de la rueda (z del cilindro de colisión): mu1 es el agarre lateral
       (bajo) y mu2 el de rodadura (alto). -->
  <xacro:macro name="wheel_friction" params="leg">
    <gazebo reference="${leg}_foot">
      <mu1>0.1</mu1>
      <mu2>1.0</mu2>
      <fdir1>0 0 1</fdir1>
    </gazebo>
  </xacro:macro>
  <xacro:wheel_friction leg="FL"/>
  <xacro:wheel_friction leg="FR"/>
  <xacro:wheel_friction leg="RL"/>
  <xacro:wheel_friction leg="RR"/>

  <!-- ===== Patas sujetas en la postura de pie ===== -->
  <xacro:macro name="hold_joint" params="joint pos">
    <gazebo>
      <plugin filename="ignition-gazebo-joint-position-controller-system"
              name="ignition::gazebo::systems::JointPositionController">
        <joint_name>${joint}</joint_name>
        <initial_position>${pos}</initial_position>
        <p_gain>300</p_gain>
        <i_gain>0</i_gain>
        <d_gain>5</d_gain>
        <cmd_max>50</cmd_max>
        <cmd_min>-50</cmd_min>
      </plugin>
    </gazebo>
  </xacro:macro>
  <xacro:macro name="hold_leg" params="leg">
    <xacro:hold_joint joint="${leg}_hip_joint" pos="0"/>
    <xacro:hold_joint joint="${leg}_thigh_joint" pos="${stand_thigh}"/>
    <xacro:hold_joint joint="${leg}_calf_joint" pos="${stand_calf}"/>
  </xacro:macro>
  <xacro:hold_leg leg="FL"/>
  <xacro:hold_leg leg="FR"/>
  <xacro:hold_leg leg="RL"/>
  <xacro:hold_leg leg="RR"/>

  <gazebo>
    <!-- /cmd_vel -> ruedas; publica la odometría y la TF odom -> base_link -->
    <plugin filename="ignition-gazebo-diff-drive-system"
            name="ignition::gazebo::systems::DiffDrive">
      <left_joint>FL_foot_joint</left_joint>
      <left_joint>RL_foot_joint</left_joint>
      <right_joint>FR_foot_joint</right_joint>
      <right_joint>RR_foot_joint</right_joint>
      <wheel_separation>0.30</wheel_separation>
      <wheel_radius>0.086</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <max_linear_velocity>1.0</max_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <topic>/model/go2w/cmd_vel</topic>
      <odom_topic>/model/go2w/odometry</odom_topic>
      <tf_topic>/model/go2w/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

    <!-- ángulos de las articulaciones -> /joint_states (robot_state_publisher) -->
    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/model/go2w/joint_states</topic>
    </plugin>
  </gazebo>

</robot>
