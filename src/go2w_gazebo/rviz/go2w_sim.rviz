Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
    - Class: navmap_rviz_plugin/NavMapDisplay
      Name: NavMap
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /maps_manager_node/navmap/map
      Update Layer Topic: /maps_manager_node/navmap/map_updates
      Alpha: 0.8
    - Class: rviz_default_plugins/Path
      Name: Planned path
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /planner_node/astar/path
      Color: 0; 255; 0
      Line Style: Billboards
      Line Width: 0.05
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Marker Scale: 0.3
    - Class: rviz_default_plugins/PointCloud2
      Name: L1 cloud
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /utlidar/cloud
      Size (m): 0.02
      Style: Points
      Color Transformer: AxisColor
    - Class: rviz_default_plugins/LaserScan
      Name: Scan
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Size (m): 0.04
      Color Transformer: FlatColor
      Color: 255; 0; 0
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odom
      Keep: 50
  Global Options:
    Fixed Frame: map
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    # Goal projected onto the NavMap surface: z on the terrain (EasyNav checks height_tolerance)
    - Class: navmap_rviz_plugin/SetGoal
      Topic: /goal_pose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15
      Focal Point: {X: 0, Y: 0, Z: 0}
      Pitch: 0.7
      Yaw: 0.8
