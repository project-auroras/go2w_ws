<?xml version="1.0"?>
<!-- GENERADO por scripts/generar_campo.py: no editar a mano, cambia el script.
     Campo de cultivo: surcos de lechuga, maíz y tomate, malas hierbas, árboles
     alrededor y una persona que camina por los pasillos.
     El robot debe empezar en (-1.5, 0.75) mirando a +x (lo hace simulacion.launch.py
     con world:=campo). -->
<sdf version="1.8">
  <world name="campo">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.8 0.95 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sol">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <!-- Suelo: hierba alrededor (con colisión) y una capa de tierra encima, solo visual
         para que no haya escalón -->
    <model name="suelo">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="hierba">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material><ambient>0.30 0.45 0.20 1</ambient><diffuse>0.30 0.45 0.20 1</diffuse></material>
        </visual>
        <visual name="tierra">
          <pose>11 0.75 0.003 0 0 0</pose>
          <geometry><plane><normal>0 0 1</normal><size>32 12</size></plane></geometry>
          <material><ambient>0.40 0.27 0.16 1</ambient><diffuse>0.40 0.27 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Surcos (caballones de 12 cm con colisión) y sus plantas (sin colisión) -->
    <model name="surco_0">
      <static>true</static>
      <pose>11.000 -3.000 0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><pose>0 0 0.060 0 0 0</pose>
          <geometry><box><size>18.000 0.500 0.120</size></box></geometry></collision>
        <visual name="tierra"><pose>0 0 0.060 0 0 0</pose>
          <geometry><box><size>18.000 0.500 0.120</size></box></geometry><material><ambient>0.35 0.23 0.13 1</ambient><diffuse>0.35 0.23 0.13 1</diffuse></material></visual>
        <visual name="l0_centro"><pose>-8.853 0.015 0.170 0.000 0.000 0.000</pose><geometry><sphere><radius>0.066</radius></sphere></geometry><material><ambient>0.45 0.70 0.25 1</ambient><diffuse>0.45 0.70 0.25 1</diffuse></material><cast_shadows>false</cast_shadows></visual>
