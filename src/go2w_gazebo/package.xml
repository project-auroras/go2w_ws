<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>go2w_gazebo</name>
  <version>0.1.0</version>
  <description>Go2-W in Gazebo Harmonic (worlds from navmap_gis_tool) and people-following simulation (RealSense + YOLO)</description>
  <maintainer email="juanlopez5110@gmail.com">AURORAS</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>go2w_bringup</exec_depend>
  <exec_depend>go2w_description</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <!-- sigue-personas (simulacion.launch.py) -->
  <exec_depend>go2w_perception</exec_depend>
  <exec_depend>yolo_bringup</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
