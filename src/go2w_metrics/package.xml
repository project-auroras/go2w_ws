<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>go2w_metrics</name>
  <version>0.0.0</version>
  <description>Hardware and ROS metrics of the test recordings: ros2_vitals + tegrastats, bags to CSV</description>
  <maintainer email="unitree@todo.todo">unitree</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>diagnostic_msgs</depend>
  <depend>ros2_vitals_msgs</depend>

  <exec_depend>ros2_vitals</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-psutil</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
