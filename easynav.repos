# EasyNav from source (Humble apt packages may lag behind). Step 5 of the plan.
repositories:
  EasyNavigation:
    type: git
    url: https://github.com/EasyNavigation/EasyNavigation.git
    version: 0.5.0
  easynav_plugins:
    type: git
    url: https://github.com/EasyNavigation/easynav_plugins.git
    version: 0.5.0
  NavMap:
    type: git
    url: https://github.com/EasyNavigation/NavMap.git
    version: 0.6.0
  yaets:
    type: git
    url: https://github.com/fmrico/yaets.git
    version: 1.2.0
